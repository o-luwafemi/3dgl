{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-Wall",
                "-g",
                "-I${workspaceFolder}/dependencies/include",
                // "-I/opt/homebrew/include",
                // "-I/opt/homebrew/opt/assimp/include",
                // "-I/opt/homebrew/include/assimp",
                "-L${workspaceFolder}/dependencies/library",
                "-L/opt/homebrew/lib",
                "${workspaceFolder}/dependencies/library/libglfw.3.4.dylib",
                "${workspaceFolder}/dependencies/library/libGLEW.2.2.0.dylib",
                "${workspaceFolder}/*.cpp",
                "${workspaceFolder}/glad.c",
                "-o",
                "${workspaceFolder}/app",
                // "${fileDirname}/${fileBasenameNoExtension}",
                "-lassimp",
                "-framework",
                "OpenGL",
                "-framework",
                "Cocoa",
                "-framework",
                "IOKit",
                "-framework",
                "CoreVideo",
                "-framework",
                "CoreFoundation",
                "-Wno-deprecated"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },

    ],
    "version": "2.0.0"
}